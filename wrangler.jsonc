{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bymoonrise",
  "compatibility_date": "2026-11-01",
  // Static-only site: Parcel builds to ./dist and Workers serves it as static assets.
  // No Worker script is needed.
  "assets": {
    "directory": "./dist",
  },
  // Production domains. www.bymoonrise.com is 301-redirected to the apex by a zone redirect rule.
  "routes": [
    { "pattern": "bymoonrise.com", "custom_domain": true },
    { "pattern": "www.bymoonrise.com", "custom_domain": true },
  ],
  // Production is served only on the custom domains above, so the public workers.dev URL is off
  // (avoids a duplicate copy of the site in search results). Preview URLs stay on for PR previews;
  // Cloudflare sends `X-Robots-Tag: noindex` on workers.dev Preview URLs.
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches.
  // Empty: previews use the same assets and settings as production.
  "previews": {},
}
